# OAuth credentials from the client_secret_*.json file downloaded from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtained once by running: npm run get-refresh-token
GOOGLE_REFRESH_TOKEN=

# ID of the parent Google Drive folder where /v1 response subfolders will be created
GOOGLE_DRIVE_PARENT_FOLDER_ID_V1=13QzGvj8wN1IpLI5i_jXnG4dvXieFVzuh

# ID of the parent Google Drive folder where /v2 response subfolders will be created
GOOGLE_DRIVE_PARENT_FOLDER_ID_V2=19a4-3ms8hQRt8YuJZW9me5CpNu7SeVAX

# Password required to access /admin (the runtime form-content editor).
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If unset, /admin and its API are refused entirely (fails closed).
ADMIN_PASSWORD=
