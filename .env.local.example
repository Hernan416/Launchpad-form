# Credenciales OAuth del archivo client_secret_*.json descargado de Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Se obtiene una sola vez corriendo: npm run get-refresh-token
GOOGLE_REFRESH_TOKEN=

# ID de la carpeta padre de Google Drive donde se crearán las subcarpetas por respuesta
GOOGLE_DRIVE_PARENT_FOLDER_ID=
